# Connection details for the integration tests (tests/integration/), against a
# LOCAL Supabase instance only — never point these at a hosted project. The
# tests create and delete users and data freely, which is only safe locally.
#
# Setup:
#   npm run db:start            # requires Docker; runs migrations automatically
#   supabase status -o env      # prints these three values
#
# Copy this file to .env.test.local and fill in what that command printed
# (API_URL -> SUPABASE_URL, ANON_KEY -> SUPABASE_ANON_KEY,
# SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY). .env.test.local is
# gitignored. Without it, `npm test` still runs the unit tests; the
# integration tests skip themselves with a reminder of this.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
